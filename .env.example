# Exemplo de variáveis de ambiente para o AMMHelpDesk
# COPIE ESTE ARQUIVO E RENOMEIE PARA .env NA RAIZ DO PROJETO

SECRET_KEY=sua-chave-secreta-django-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=helpdesk
DB_USER=helpdesk_user
DB_PASSWORD=sua-senha-do-banco-aqui
DB_HOST=db
DB_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-aplicativo-aqui
